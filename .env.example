# 应用监听端口（宿主机映射）
APP_PORT=8080

# PostgreSQL 连接配置（docker compose 内部服务名固定为 db）
POSTGRES_USER=caltrace
POSTGRES_PASSWORD=caltrace
POSTGRES_DB=caltrace
# 数据库在宿主机暴露的端口，默认仅绑定回环地址；不对外可用可直接删除映射
POSTGRES_PORT=127.0.0.1:5432

# 若不用 compose、直连外部数据库，应用读取以下变量（app/config.py）：
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=caltrace
# DB_USER=caltrace
# DB_PASSWORD=caltrace

# 管理密钥：创建签收邀请、查询签收录制，标准证书临时停用的登记/解除/查询，
# 标准证书每日校准使用量上限的设定/调整/查询，以及设备校准委托工单的登记/
# 取消/结清/查询时经 X-Management-Key 头校验。
# 仅本地配置、不落库；默认值仅供本机开发，生产部署必须改为随机长密钥。
DELIVERY_MANAGEMENT_KEY=caltrace-delivery-admin

# 普通证书“双人复核签发”的本地身份凭据表：逗号分隔，每项为 身份名=凭据。
# 录入人提交申请经 X-Entry-Key 头校验；复核人驳回/批准经 X-Reviewer-Key 头校验。
# 录入与复核必须使用不同凭据（同凭据复核返回 403 reviewer_must_differ）。
# 凭据仅本地配置、不落库（库内仅存 SHA-256 用于双人校验）；默认值仅供本机开发，生产必须改为随机长密钥。
CERTIFICATE_ENTRY_KEYS=entry-1=caltrace-entry-key
CERTIFICATE_REVIEWER_KEYS=reviewer-1=caltrace-review-key-1,reviewer-2=caltrace-review-key-2
